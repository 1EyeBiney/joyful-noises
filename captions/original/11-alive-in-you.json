      "end": 32.52,
      "text": "Not my strength\nNot my name"
    },
    {
      "start": 32.52,
      "end": 36.62,
      "text": "Not the things\nI thought I'd made"
    },
    {
      "start": 36.62,
      "end": 40.8,
      "text": "Not my plans\nNot my pride"
    },
    {
      "start": 40.8,
      "end": 44.94,
      "text": "You became\nThe life inside"
    },
    {
      "start": 44.94,
      "end": 49.28,
      "text": "I was reaching\nOn my own"
    },
    {
      "start": 49.28,
      "end": 53.22,
      "text": "Trying hard\nTo stand alone"
    },
    {
      "start": 53.22,
      "end": 57.28,
      "text": "Then Your mercy\nCalled me through"
    },
    {
      "start": 57.28,
      "end": 61.56,
      "text": "Now my life\nIs found in You"
    },
    {
      "start": 61.56,
      "end": 69.8,
      "text": "I let go\nWhile You remain"
    },
    {
      "start": 69.8,
      "end": 77.9,
      "text": "Less of me\nMore of Your name"
    },
    {
      "start": 77.9,
      "end": 86.02,
      "text": "Alive in You\nAlive in You"
    },
    {
      "start": 86.02,
      "end": 94.18,
      "text": "Christ in me\nMakes all things new"
    },
    {
      "start": 94.18,
      "end": 98.62,
      "text": "Not my strength\nNot my name"
    },
    {
      "start": 98.62,
      "end": 105.68,
      "text": "Jesus, You\nBrought life again"
    },
    {
      "start": 116.5,
      "end": 122.5,
      "text": "I can move"
